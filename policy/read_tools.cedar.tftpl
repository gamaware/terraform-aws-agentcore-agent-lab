permit(
  principal is AgentCore::OAuthUser,
  action in [
    AgentCore::Action::"orders___get_order",
    AgentCore::Action::"stock___check_stock",
    AgentCore::Action::"policies___search_policies"
  ],
  resource == AgentCore::Gateway::"${gateway_arn}"
) when {
  principal.hasTag("cognito:groups") &&
  (principal.getTag("cognito:groups") like "*store-associates*" ||
   principal.getTag("cognito:groups") like "*store-leads*")
};
